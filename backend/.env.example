APP_NAME=ResQPH API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=resqph
FRONTEND_ORIGINS=http://localhost:5173
# Local HTTP development only. Set AUTH_COOKIE_SECURE=true for HTTPS deployments.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_HOURS=12
AUTH_ALLOW_DEMO_HEADERS=false
ROUTE_SNAP_MAX_DISTANCE_M=900
SIMULATION_SPEED_MPS=5
REPORT_RATE_LIMIT_PER_MINUTE=5
ROUTE_RATE_LIMIT_PER_MINUTE=10
TRACKING_RATE_LIMIT_PER_MINUTE=60
SIMULATION_CONTROL_RATE_LIMIT_PER_MINUTE=10
BROAD_IP_RATE_LIMIT_PER_MINUTE=180
GOOGLE_WEATHER_API_KEY=

# Optional ML runtime gate. Leave disabled unless Ranee accepts a U-Belt
# artifact whose metadata and ordered feature schema match the backend contract.
ML_ENABLED=false
ML_ARTIFACT_PATH=
ML_METADATA_PATH=
ML_ARTIFACT_SHA256=
