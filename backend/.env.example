APP_NAME=ResQPH API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=resqph
FRONTEND_ORIGINS=http://localhost:5173
